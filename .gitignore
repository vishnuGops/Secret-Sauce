# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/

# Generated
*.g.dart
*.freezed.dart
*.config.dart

# IDE
.idea/
.vscode/*
!.vscode/launch.json
*.iml

# Melos
.melos_tool/

# Env / secrets
*.env
.env*
supabase/.env
# Supabase CLI local state. `.temp` gains project-ref / pooler-url after
# `supabase link`, so it must never be committed.
supabase/.branches/
supabase/.temp/

# Database dumps (`melos run db:backup`). A production dump contains every
# account row in `auth.users` — including password hashes — and every private
# recipe. It never belongs in the repo, whatever it is named.
backups/
*_dump.sql
public_*.sql
auth_*.sql
# Local dart-define env files (keep the committed example only).
# Extension-less globs on purpose: a file saved as `env.local` (no .json) holds the
# same live credentials but was NOT matched by `**/env.local.json` alone.
env.local*
**/env.local*
**/env.*.local*
!**/env.example.json
# Shell-only secrets (B034). `SUPABASE_DB_URL` is a Postgres SUPERUSER credential
# and must never sit in a dart-define file, because every key in one is compiled
# into the shipped bundle. It lives in a dot-sourced script instead — per project,
# so it cannot collide with another repo's database, and a `.ps1` can never be
# handed to `--dart-define-from-file` by accident.
*.local.ps1
**/*.local.ps1
!**/*.example.ps1

# Playwright MCP scratch output (page snapshots, console logs, screenshots).
# Written into the working directory by any browser-driven run — the B028
# screenshot procedure and the design-canvas checks both produce it. Tool state,
# never a deliverable; same reason supabase/.temp is ignored above.
.playwright-mcp/

# Generated by `tool/corpus_import.dart gen` (Phase 35c) — ~71 MB for a
# 21,000-recipe tier, and re-derivable from the corpus shards in seconds. The
# committed artifact is the TOOL, never its output. Stated here as well as in
# `corpus/.gitignore` because `corpus/` itself is not tracked, so that file
# would not be consulted for anything staged from outside it.
corpus/_import/
corpus/_import_*/

# ---------------------------------------------------------------------------
# The scraped corpus and its tooling (Phases 34-35)
# ---------------------------------------------------------------------------
# What is tracked is the SOURCE: the scraper scripts, the hand-curated source
# registry, the chef registry, the authored fixtures and the READMEs. What is
# not is everything a command can reproduce, plus the machine state that a
# command rewrites every time it runs.
#
# The distinction is worth stating because both halves live in the same two
# directories, so "is this directory in git" is the wrong question — the right
# one is "did a person write this, or did a script".

# Dependencies.
recipeData/_tools/node_modules/
# tool/recipe_covers.dart keeps the model's original bytes here (several MB each);
# the committed cover is the re-encoded recipeData/covers/<slug>.jpg.
recipeData/covers/_raw/

# Generated roll-ups. `corpus/README.md` says it plainly: delete them and re-run
# `corpus_index.mjs`. 11 MB of chefs.json is the largest single file in the tree
# and the most completely re-derivable.
corpus/chefs.json
corpus/groups.json
corpus/restaurants.json

# Generated reports. `report.mjs` writes CORPUS.md and says "do not edit,
# re-run it" in its own header; the probe reports are one file per candidate
# batch and exist to be read once, then promoted from.
corpus/_reports/
corpus/export/
recipeData/_reports/

# Harvester and ingest state. This is the one entry that overrides an earlier
# intention rather than restating it: `corpus/.gitignore` says "keep the
# resume state", and at the scale the harvest actually reached that is 592
# files and ~50 MB that the harvester rewrites on **every run**. Tracking it
# would put a 50 MB diff behind each harvest for state that is worthless on any
# machine but the one that produced it — and it is not a loss, because the
# state's only job is to let an interrupted run resume in place.
corpus/_state/
recipeData/_state/
