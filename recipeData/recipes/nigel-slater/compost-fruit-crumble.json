    {
      "order": 2,
      "text": "Chop the pears, apple and nectarines and place in a pan over a low heat with the lemon juice. Warm through for 10 minutes.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Chop the pears, apple and nectarines and place in a pan over a low heat with the lemon juice. Warm through for 10 minutes."
    },
    {
      "order": 3,
      "text": "For the crumble topping, in a bowl, rub together the flour and butter with your hands until it resembles breadcrumbs. Add the remaining dry ingredients and the demarara sugar. Set aside.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "For the crumble topping, in a bowl, rub together the flour and butter with your hands until it resembles breadcrumbs. Add the remaining dry ingredients and the demarara sugar. Set aside."
    },
    {
      "order": 4,
      "text": "Take a small roasting tin. Layer the warm fruit on the bottom, along with the chopped banana. Sprinkle with the golden caster sugar.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Take a small roasting tin. Layer the warm fruit on the bottom, along with the chopped banana. Sprinkle with the golden caster sugar."
    },
    {
      "order": 5,
      "text": "Top with the crumble mixture and bake for 20-30 minutes, or until the topping is golden-brown. Serve immediately with cream or custard.",
