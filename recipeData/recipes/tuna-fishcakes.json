  "step_groups": [
    {
      "name": "",
      "steps": [
        {
          "text": "In a small skillet, heat the butter over medium heat. Cook the yellow onion and garlic until translucent and fragrant.",
          "duration_minutes": 5,
          "temperature": "medium"
        },
        {
          "text": "Add every remaining ingredient except the frying oil to a large bowl, including the cooked onion and garlic. Mix well."
        },
        {
          "text": "Using a 1/4 cup measuring cup, scoop up the mixture and form it into patties about 1/2-inch thick.",
          "tip": "Press firmly — loosely packed cakes fall apart in the pan."
        },
        {
          "text": "Heat oil in a cast iron skillet over medium heat and cook the fishcakes until golden, 1-2 minutes per side. Sprinkle with salt and serve hot with your favourite dipping sauce.",
          "duration_minutes": 4,
          "temperature": "medium"
        }
      ]
