  "steps": [
    {
      "order": 1,
      "text": "To prepare these amazing yogurt balls, you need to drain all the excess water from the yogurt. Lay a piece of muslin (loosely woven cotton fabric) on a workbench and place the yogurt in the centre. Gather up the muslin sides and tie with string; place on a drainer over a large bowl and leave to drain in the fridge for 12-14 hours.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": {
        "@type": "HowToStep",
        "text": "To prepare these amazing yogurt balls, you need to drain all the excess water from the yogurt. Lay a piece of muslin (loosely woven cotton fabric) on a workbench and place the yogurt in the centre. Gather up the muslin sides and tie with string; place on a drainer over a large bowl and leave to drain in the fridge for 12-14 hours.",
        "url": "https://www.mygreekdish.com/recipe/yogurt-balls-fresh-herbs/#instruction-step-1"
      }
    },
    {
      "order": 2,
      "text": "Remove the muslin and place the yogurt in a large bowl. Add the fresh herbs, the lemon zest and lime zest and blend. Roll the yogurt into golf-sized balls, lay on a baking tray and put them in the fridge for another 2-3 hours.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": {
