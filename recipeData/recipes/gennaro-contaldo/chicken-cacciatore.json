  "steps": [
    {
      "order": 1,
      "text": "Heat the oil in a frying pan and fry the onion, celery and carrots for 4–5 minutes, or until softened. Add the chicken pieces and continue to cook for 2–3 minutes or until they have browned a little.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Heat the oil in a frying pan and fry the onion, celery and carrots for 4–5 minutes, or until softened. Add the chicken pieces and continue to cook for 2–3 minutes or until they have browned a little."
    },
    {
      "order": 2,
      "text": "Pour in the wine and continue to cook until the volume of the liquid has reduced by half. Stir in the tomato purée and the stock. Add the herbs, season with salt and freshly ground black pepper then reduce the heat and simmer for 20–25 minutes, or until the chicken is cooked through.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Pour in the wine and continue to cook until the volume of the liquid has reduced by half. Stir in the tomato purée and the stock. Add the herbs, season with salt and freshly ground black pepper then reduce the heat and simmer for 20–25 minutes, or until the chicken is cooked through."
    },
    {
      "order": 3,
      "text": "Meanwhile, cook the polenta according to packet instructions. Add the butter and parmesan and stir until well combined.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Meanwhile, cook the polenta according to packet instructions. Add the butter and parmesan and stir until well combined. "
    },
    {
