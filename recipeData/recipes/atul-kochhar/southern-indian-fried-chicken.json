  "steps": [
    {
      "order": 1,
      "text": "Marinate the chicken in the salt, ginger and garlic paste, lemon juice, one teaspoon of the red chilli powder and the curry leaves. Cover the chicken and place in the fridge for an hour.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Marinate the chicken in the salt, ginger and garlic paste, lemon juice, one teaspoon of the red chilli powder and the curry leaves. Cover the chicken and place in the fridge for an hour."
    },
    {
      "order": 2,
      "text": "Meanwhile in a mixing bowl add gram flour, rice flour, plain flour, the remaining red chilli powder and salt.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Meanwhile in a mixing bowl add gram flour, rice flour, plain flour, the remaining red chilli powder and salt."
    },
    {
      "order": 3,
      "text": "Heat a deep fat fryer to 180C/350F (CAUTION: hot oil can be dangerous. Do not leave unattended.) Dust the marinated chicken cubes in the seasoned flour mixture, then deep-fry the chicken until crisp and cooked through. Sprinkle the chicken with garam masala.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Heat a deep fat fryer to 180C/350F (CAUTION: hot oil can be dangerous. Do not leave unattended.) Dust the marinated chicken cubes in the seasoned flour mixture, then deep-fry the chicken until crisp and cooked through. Sprinkle the chicken with garam masala."
    },
    {
      "order": 4,
      "text": "For the tomato chutney, heat some oil in a small frying pan and lightly sauté the curry leaves. Drain on kitchen paper.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "For the tomato chutney, heat some oil in a small frying pan and lightly sauté the curry leaves. Drain on kitchen paper. "
    },
    {
      "order": 5,
      "text": "Place the curry leaves, garlic, coriander, shallot, salt, chilli powder, cumin seeds in a stone pestle and mortar. Crush the mixture gently. Add tomato wedges and lemon juice, blending them in to the mixture. Season to taste with more salt and lemon juice.",
      "stepGroup": null,
      "subSteps": [],
      "durationMinutes": null,
      "temperature": null,
      "utensils": [],
      "imageUrl": null,
      "tip": null,
      "raw": "Place the curry leaves, garlic, coriander, shallot, salt, chilli powder, cumin seeds in a stone pestle and mortar. Crush the mixture gently. Add tomato wedges and lemon juice, blending them in to the mixture. Season to taste with more salt and lemon juice."
    },
    {
      "order": 6,
      "text": "Place the fried chicken on a serving plate with the chutney alongside.",
