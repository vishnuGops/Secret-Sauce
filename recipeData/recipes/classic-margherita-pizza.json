      "name": "Dough",
      "steps": [
        {
          "text": "Dissolve the yeast in the warm water and let it sit until foamy.",
          "duration_minutes": 10,
          "tip": "No foam means dead yeast — start again rather than pressing on."
        },
        {
          "text": "Mix the flour and salt, add the yeast water, and knead into a smooth dough.",
          "duration_minutes": 10
        },
        {
          "text": "Cover and let rise until doubled.",
          "duration_minutes": 90
        }
      ]
    },
    {
      "name": "Shape and bake",
      "steps": [
        {
          "text": "Stretch the dough by hand into a thin round and top with the crushed tomato and torn mozzarella.",
          "tip": "Hands, not a rolling pin — a pin crushes out the gas that makes the rim puff."
        },
        {
          "text": "Bake in the hottest possible oven until the crust is charred and bubbling.",
          "duration_minutes": 10,
