  "step_groups": [
    {
      "name": "Sponge",
      "steps": [
        {
          "text": "Whisk the egg whites to soft peaks, then gradually add the sugar and whisk to stiff, glossy peaks.",
          "duration_minutes": 5
        },
        {
          "text": "Beat in the yolks one at a time, then fold in the flour and baking powder alternately with the milk and vanilla."
        },
        {
          "text": "Pour into a buttered tin and bake until springy and golden.",
          "duration_minutes": 25,
          "temperature": "180°C / 355°F"
