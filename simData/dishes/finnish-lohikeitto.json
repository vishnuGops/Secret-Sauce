  "step_groups": [
    {
      "name": "",
      "steps": [
        {
          "text": "Soften the leek and carrot in the butter without colouring.",
          "duration_minutes": 6,
          "temperature": "medium"
        },
        {
          "text": "Add the potatoes, fish stock, bay leaf, and allspice berries and simmer until the potatoes are just tender.",
          "duration_minutes": 15
        },
        {
          "text": "Pour in the cream, season with salt, and bring back to a bare simmer.",
          "duration_minutes": 2
        },
        {
          "text": "Add the salmon, cover, take the pot off the heat, and let it poach in the residual heat.",
          "duration_minutes": 5,
          "tip": "Boiling toughens salmon and breaks it into flakes. Off the heat it stays in cubes, barely opaque."
        },
        {
          "text": "Stir through plenty of dill and serve."
        }
      ]
    }
