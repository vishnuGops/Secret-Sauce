        { "quantity": 2, "unit": "cloves", "name": "garlic", "note": "peeled, whole", "food": "garlic" },
        { "quantity": 1, "unit": "tsp", "name": "cumin", "note": "ground" },
        { "quantity": 1, "unit": "tsp", "name": "sweet paprika", "food": "smoked-paprika" },
        { "quantity": 0.5, "unit": "tsp", "name": "cinnamon", "note": "ground" },
        { "quantity": 2, "unit": "tbsp", "name": "lemon juice", "food": "lemon-juice" },
        { "quantity": 3, "unit": "tbsp", "name": "olive oil", "food": "olive-oil" },
        { "quantity": 1, "unit": "tsp", "name": "honey", "food": "honey" },
        { "quantity": 0.5, "unit": "tsp", "name": "salt", "food": "kosher-salt" },
