      ]
    }
  ],
  "step_groups": [
    {
      "name": "",
      "steps": [
        {
          "text": "Boil the carrots with the whole garlic cloves until just tender but still with some bite.",
          "duration_minutes": 8,
          "tip": "Overcooked, they turn to baby food once the dressing goes on."
        },
        {
          "text": "Drain, then crush the garlic and whisk it with the cumin, paprika, cinnamon, lemon juice, olive oil, honey, and salt."
        },
        {
          "text": "Toss the warm carrots in the dressing and leave to absorb it.",
          "duration_minutes": 30
        },
        {
          "text": "Serve at room temperature, scattered with cilantro."
        }
      ]
    }
  ],
