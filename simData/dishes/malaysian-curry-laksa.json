  "step_groups": [
    {
      "name": "",
      "steps": [
        {
          "text": "Blend the soaked dried red chillies, shallots, garlic, lemongrass, turmeric, belacan, and candlenuts into a fine paste."
        },
        {
          "text": "Fry the paste in oil over a medium heat until it darkens and the oil separates.",
          "duration_minutes": 15,
          "tip": "Fifteen minutes is not an exaggeration. Underfried paste tastes raw and grainy in the finished soup."
        },
        {
          "text": "Add the chicken stock and bring to a simmer, then stir in the coconut milk and fish sauce.",
          "duration_minutes": 10,
          "tip": "Keep it below a rolling boil once the coconut milk is in, or it splits."
        },
        {
          "text": "Add the tofu puffs and let them drink the broth.",
          "duration_minutes": 5
        },
        {
          "text": "Poach the prawns in the soup until just opaque.",
          "duration_minutes": 3
        },
        {
          "text": "Cook the rice noodles separately, divide between bowls, and ladle the soup over."
        },
        {
          "text": "Top with bean sprouts and Vietnamese mint, and serve with lime wedges."
        }
      ]
    }
  ],
